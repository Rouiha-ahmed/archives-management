# Minimum configuration for normal local development. Copy this file to .env,
# replace CHANGE_ME, and generate two independent secrets. Never commit .env.
DATABASE_URL="postgresql://archives:CHANGE_ME@127.0.0.1:5432/archives_db?schema=public"
AUTH_SECRET=""
AUTH_RATE_LIMIT_SECRET=""

# Generate each secret separately with: openssl rand -base64 48
#
# Migration-only: put this in the ignored .env.local file when using
# `npm run db:migrate`. Prisma Migrate must use the dedicated shadow database.
# SHADOW_DATABASE_URL="postgresql://archives:CHANGE_ME@127.0.0.1:5432/archives_shadow?schema=public"
#
# Test-only: put this in the ignored .env.test.local file. The database name must
# contain `_test`; integration and browser tests may truncate it.
# TEST_DATABASE_URL="postgresql://archives:CHANGE_ME@127.0.0.1:5432/archives_test?schema=public"
#
# Optional runtime overrides; local defaults are already safe.
# AUTH_URL="http://localhost:3000"          # Canonical HTTPS origin in production.
# AUTH_TRUST_HOST="true"                    # Trusted proxies only.
# APP_TIME_ZONE="Africa/Casablanca"         # Default value shown here.
# SIGNATURE_STORAGE_DIR="./storage"         # Must remain private, outside public/.
#
# One-time administrator bootstrap. Supply all three only for `npm run db:seed`
# when no active administrator exists, then remove them immediately.
# BOOTSTRAP_ADMIN_NAME=""
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_PASSWORD=""
#
# Demo seed controls are command-scoped; do not persist them in .env.
# ALLOW_DEMO_SEED="true"
# DEMO_LOGIN_ENABLED="false"
# DEMO_USER_PASSWORD=""
