# Local development only. Copy this file to .env before running Prisma commands.
# Replace CHANGE_ME with the URL-safe password assigned to the local `archives`
# PostgreSQL role. Never commit the real password.
DATABASE_URL="postgresql://archives:CHANGE_ME@127.0.0.1:5432/archives_db?schema=public"
SHADOW_DATABASE_URL="postgresql://archives:CHANGE_ME@127.0.0.1:5432/archives_shadow?schema=public"

# Generate independent values with: openssl rand -base64 48
AUTH_SECRET=""
AUTH_RATE_LIMIT_SECRET=""

# Set in production to the canonical HTTPS origin. If deployed behind a trusted
# proxy, set AUTH_TRUST_HOST=true only after validating forwarded host headers.
AUTH_URL=""
AUTH_TRUST_HOST=""

# IANA timezone used when presenting UTC timestamps in the UI.
APP_TIME_ZONE="Africa/Casablanca"

# Private writable directory, outside `public`. Defaults to ./storage locally.
SIGNATURE_STORAGE_DIR=""

# Optional one-time bootstrap. Leave all three blank after an active ADMIN exists.
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Tests that touch the database require a dedicated database name containing `_test`.
TEST_DATABASE_URL="postgresql://archives:CHANGE_ME@127.0.0.1:5432/archives_test?schema=public"

# Optional local demo dataset. Prefer setting these for one shell command instead
# of persisting them. The seed also requires NODE_ENV=development and a loopback DB.
ALLOW_DEMO_SEED="false"
DEMO_LOGIN_ENABLED="false"
DEMO_USER_PASSWORD=""
