{
  "name": "archives-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:up": "bash scripts/postgres-local.sh start",
    "db:down": "bash scripts/postgres-local.sh stop",
    "db:status": "bash scripts/postgres-local.sh status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/demo-seed.ts",
    "db:verify:demo": "tsx prisma/demo-verify.ts",
    "db:demo:report": "tsx prisma/demo-report.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@zxing/browser": "^0.2.1",
    "argon2": "^0.45.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "signature_pad": "^5.1.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
